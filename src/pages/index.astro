---
import Site from '../layouts/Site.astro';
import HomeIssue from '../components/HomeIssue.astro';
import HomePractice from '../components/HomePractice.astro';
import articles from '../lib/content.mjs';
import { articlePath, categoryPath, path } from '../lib/site';
import { photoForArticle } from '../lib/media';
import '../styles/home-front.css';

const image = {
  wide: path('photos/warehouse-front-1536.webp'),
  narrow: path('photos/warehouse-front-768.webp'),
};
const lead = articles.find(article => article.slug === 'warehouse-move')!;
const leadPhoto = photoForArticle(lead.slug);
const routes = [
  { id: 'storage', title: 'Выбрать склад', description: 'Как сравнить операторов, посчитать хранение и заложить запас мест.' },
  { id: 'operations', title: 'Подготовить поставку', description: 'Приёмка товара, расписание отгрузок и переезд склада.' },
  { id: 'fulfillment', title: 'Разобраться в фулфилменте', description: 'Тарифы, схемы FBO и FBS, обработка возвратов.' },
];
---
<Site title="Журнал о складской логистике" description="Практические статьи для тех, кто выбирает склад, организует поставки и сравнивает фулфилмент." image={image.wide} section="home">
  <section class="warehouse-front" aria-labelledby="home-title">
    <div class="warehouse-front__media" aria-hidden="true">
      <img src={image.wide} srcset={image.narrow + ' 768w, ' + image.wide + ' 1536w'} sizes="100vw" width="1536" height="1024" fetchpriority="high" alt="" />
    </div>
    <div class="wrap warehouse-front__inner">
      <div class="warehouse-front__masthead">
        <h1 id="home-title"><span>Складская</span> <span>практика</span></h1>
        <p>Журнал о складской логистике</p>
      </div>
      <div class="warehouse-front__feature">
        <article class="warehouse-front__story" aria-labelledby="lead-title">
          <p class="warehouse-front__rubric">Складские операции <span aria-hidden="true">/</span> {lead.minutes} мин</p>
          <h2 id="lead-title">Переезд склада без остановки отгрузок</h2>
          <p class="warehouse-front__summary">Как перенести запасы партиями, проверить новый склад и сохранить график отгрузок.</p>
          <a class="button warehouse-front__action" href={articlePath(lead.slug)}>Читать о переезде <span aria-hidden="true">→</span></a>
        </article>
        <figure class="warehouse-front__detail">
          <img src={leadPhoto.small} width={leadPhoto.smallWidth} height={leadPhoto.smallHeight} decoding="async" alt={leadPhoto.alt} style={{ objectPosition: leadPhoto.position }} />
        </figure>
      </div>
    </div>
  </section>

  <section class="home-routes" aria-labelledby="routes-title" id="guides">
    <div class="wrap route-guide">
      <div class="route-guide__intro"><h2 id="routes-title">Что нужно сделать?</h2></div>
      <ul class="route-guide__list">
        {routes.map(route => (
          <li>
            <a href={categoryPath(route.id)}>
              <div><h3>{route.title}</h3><p>{route.description}</p></div>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <HomeIssue featured="warehouse-site-audit" secondary={['first-delivery', 'compare-fulfillment']} />

  <HomePractice />
</Site>