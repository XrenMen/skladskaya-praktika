---
import Site from '../layouts/Site.astro';
import articles from '../lib/content.mjs';
import { articlePath, categoryPath, path } from '../lib/site';
import { loadingBay as cover, photoForArticle } from '../lib/media';


const routes = [
  { id: 'storage', title: 'Выбрать склад', description: 'Модели хранения, выбор оператора и расчёт стоимости.' },
  { id: 'operations', title: 'Подготовить поставку', description: 'Приёмка товара, расписание отгрузок и переезд склада.' },
  { id: 'fulfillment', title: 'Разобраться в фулфилменте', description: 'Тарифы, схемы FBO и FBS, обработка возвратов.' },
];
const selected = ['storage-cost', 'first-delivery', 'compare-fulfillment'].map(slug => {
  const article = articles.find(item => item.slug === slug)!;
  return { article, image: photoForArticle(slug) };
});
---
<Site title="Журнал о складской логистике" description="Практические статьи для тех, кто выбирает склад, организует поставки и сравнивает фулфилмент." image={cover.large} section="home">
  <section class="dock-hero" aria-labelledby="lead-title">
    <picture class="dock-hero__media" aria-hidden="true">
      <img src={cover.large} srcset={cover.srcset} sizes="100vw" width="1536" height="1024" fetchpriority="high" alt="" />
    </picture>
    <div class="wrap dock-hero__inner">
      <p class="dock-hero__label">Журнал о складской логистике</p>
      <h1 id="lead-title"><span>Переезд склада</span> <span>без остановки отгрузок</span></h1>
      <p class="dock-hero__summary">Как перенести запасы партиями, проверить новый склад и сохранить график отгрузок.</p>
      <a class="button dock-hero__action" href={articlePath('warehouse-move')}>Читать статью <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="wrap route-guide" aria-labelledby="routes-title" id="guides">
    <div class="route-guide__intro">
      <h2 id="routes-title">Что нужно сделать?</h2>
    </div>
    <ul class="route-guide__list">
      {routes.map(route => (
        <li>
          <a href={categoryPath(route.id)}>
            <div><h3>{route.title}</h3><p>{route.description}</p></div>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap work-selection" aria-labelledby="work-title">
    <div class="work-selection__heading">
      <h2 id="work-title">Материалы для работы</h2>
      <a href={path('materials/')}>Все статьи <span aria-hidden="true">↗</span></a>
    </div>
    <div class="work-selection__grid">
      {selected.map(({article,image}, index) => (
        <a class:list={['work-story', {'work-story--lead': index === 0}]} href={articlePath(article.slug)}>
          <div class="work-story__media">
            <img src={image.small} srcset={image.srcset} sizes={index === 0 ? '(max-width: 700px) 92vw, 690px' : '(max-width: 480px) 28vw, 168px'} width="640" height="427" loading="lazy" style={{objectPosition: image.position}} alt={image.alt}/>
          </div>
          <div class="work-story__text">
            <h3>{article.title}</h3>
            {index === 0 && <p>{article.description}</p>}
            <span class="work-story__time">{article.minutes} мин</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pallet-band" id="calculator" aria-labelledby="pallet-title">
    <div class="pallet-band__copy">
      <h2 id="pallet-title">Калькулятор паллето-дней</h2>
      <p>Оцените объём и стоимость хранения по среднему остатку, сроку и тарифу.</p>
      <a href={path('calculator/')}>Открыть калькулятор <span aria-hidden="true">→</span></a>
    </div>
    <p class="pallet-band__example"><strong>2 400</strong><span>паллето-дней<br/>80 паллет × 30 дней</span></p>
  </section>
</Site>