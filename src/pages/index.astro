---
import Site from '../layouts/Site.astro';
import articles from '../lib/content.mjs';
import { photoForArticle, photoLicenseUrl } from '../lib/media';
import { articleTeaserTitle } from '../lib/teaser-titles';
import { articlePath, path } from '../lib/site';
import '../styles/notebook-home.css';

const featuredSlug = 'receiving-discrepancies';
const featuredPhoto = photoForArticle(featuredSlug);
const orderedSlugs = [
  'first-warehouse-month', 'warehouse-returns-case', 'first-warehouse-invoice', 'order-picking-check',
  'warehouse-location-labels',
  'cycle-counting', 'warehouse-site-audit', 'compare-fulfillment', 'first-delivery',
  'warehouse-move', 'storage-cost', 'returns', 'peak-pallet-capacity',
  'dispatch-slots', 'choose-operator', 'own-vs-outsourced', featuredSlug,
];
const entryPaths = [
  { title: 'Выбираю склад', links: [
    { label: 'Опросник', href: articlePath('choose-operator') },
    { label: 'Сравнить сметы', href: path('tools/warehouse-quotes/') },
  ] },
  { title: 'Готовлю первую поставку', links: [
    { label: 'Приёмка', href: articlePath('first-delivery') },
    { label: 'Журнал расхождений', href: articlePath('receiving-discrepancies') + '#razdel-2' },
  ] },
  { title: 'Проверяю первый счёт', links: [
    { label: 'Сверка счёта', href: articlePath('first-warehouse-invoice') },
    { label: 'Расчёт хранения', href: path('calculator/') },
  ] },
];
const topics = [
  { id: 'all', title: 'Все темы' },
  { id: 'operations', title: 'Операции' },
  { id: 'storage', title: 'Хранение' },
  { id: 'fulfillment', title: 'Фулфилмент' },
];
const previewCount = 4;
const templates = [
  { file: 'warehouse-rate-request.xlsx', label: 'Запрос тарифа у склада' },
  { file: 'receiving-discrepancy-log.xlsx', label: 'Журнал расхождений' },
];
const categoryLabels: Record<string, string> = {
  operations: 'Складские операции',
  storage: 'Хранение',
  fulfillment: 'Фулфилмент',
};
const articlesBySlug = new Map(articles.map(article => [article.slug, article]));
const orderedStories = [
  ...orderedSlugs.flatMap(slug => {
    const article = articlesBySlug.get(slug);
    return article ? [article] : [];
  }),
  ...articles.filter(article => !orderedSlugs.includes(article.slug)),
];
const featuredStory = articlesBySlug.get(featuredSlug);
const featuredTitle = featuredStory ? articleTeaserTitle(featuredStory) : 'Недостача и пересорт на приёмке';
---

<Site title="Журнал о работе склада" description="Практические статьи для тех, кто выбирает склад, организует поставки и сравнивает фулфилмент." image={featuredPhoto.large} section="home">
  <div class="nb-home">
    <header class="nb-masthead nb-width">
      <h1 id="home-title">Журнал о работе склада</h1>
      <form class="nb-search" id="nb-search" role="search" action={path('search/')}>
        <label class="nb-visually-hidden" for="nb-query">Фильтр ленты по заголовкам, описаниям и темам</label>
        <input id="nb-query" name="q" type="search" placeholder="Заголовок или тема" autocomplete="off" maxlength="120" aria-controls="nb-grid" />
        <button type="submit">Фильтр ленты</button>
      </form>
    </header>

    <div class="nb-opening nb-width">
      <figure class="nb-lead" id="issue" aria-labelledby="lead-title">
        <a class="nb-lead__link" href={articlePath(featuredSlug)} aria-labelledby="lead-title" aria-describedby="lead-deck">
          <div class="nb-lead__media">
            <img
              src={featuredPhoto.large}
              srcset={featuredPhoto.srcset}
              sizes="(max-width: 1050px) 94vw, (max-width: 1560px) 68vw, 1060px"
              width={featuredPhoto.largeWidth}
              height={featuredPhoto.largeHeight}
              alt={featuredPhoto.alt}
              fetchpriority="high"
            />
          </div>
          <div class="nb-lead__text">
            <h2 id="lead-title">{featuredTitle}</h2>
            <p id="lead-deck">Что делать, если в накладной 40 коробов, а нужного артикула приехало 37.</p>
          </div>
        </a>
        <figcaption class="nb-credit">Фото <a href={featuredPhoto.source}>{featuredPhoto.photographer}</a> · <a href={photoLicenseUrl}>Pexels</a></figcaption>
      </figure>
      <nav class="nb-routes" aria-labelledby="nb-routes-title">
        <h2 id="nb-routes-title">С чего начать</h2>
        <ul>
          {entryPaths.map(route => (
            <li class="nb-route">
              <h3>{route.title}</h3>
              <div class="nb-route__links">
                {route.links.map(link => (
                  <a href={link.href}>{link.label} <span class="nb-arrow" aria-hidden="true">→</span></a>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <section id="articles" class="nb-width nb-feed" aria-labelledby="nb-feed-title">
      <div class="nb-feed__header" id="guides">
        <div class="nb-feed__title">
          <h2 id="nb-feed-title">Статьи</h2>
          <a class="nb-archive-link" href={path('materials/')}>Все {articles.length} статей <span class="nb-arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="nb-filters" role="group" aria-label="Темы статей" hidden>
          {topics.map(topic => (
            <button type="button" data-topic={topic.id} aria-pressed={topic.id === 'all' ? 'true' : 'false'}>{topic.title}</button>
          ))}
        </div>
      </div>
      <div class="nb-feedback" id="nb-feedback">
        <p class="nb-status" id="nb-status" role="status" aria-atomic="true"></p>
        <div class="nb-feedback__actions" id="nb-feedback-actions" hidden>
          <a id="nb-search-all" href={path('search/')} hidden>Искать по текстам статей <span class="nb-arrow" aria-hidden="true">→</span></a>
          <button id="nb-reset" type="button">Сбросить фильтр</button>
        </div>
      </div>
      <div class="nb-grid" id="nb-grid">
        {orderedStories.map((article, index) => {
          const photo = photoForArticle(article.slug);
          const title = articleTeaserTitle(article);
          const label = categoryLabels[article.category] ?? article.category;
          const isPreview = index < previewCount && article.slug !== featuredSlug;

          return (
            <article class="nb-story" data-category={article.category} data-search={title + ' ' + article.title + ' ' + article.description + ' ' + label} data-preview={String(isPreview)} hidden={!isPreview}>
              <a class="nb-story__link" href={articlePath(article.slug)} aria-labelledby={'nb-title-' + article.slug} aria-describedby={'nb-deck-' + article.slug}>
                <img
                  src={photo.small}
                  srcset={photo.srcset}
                  sizes="auto, (max-width: 520px) 94vw, (max-width: 1050px) 46vw, 23vw"
                  width={photo.smallWidth}
                  height={photo.smallHeight}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  style={{ objectPosition: photo.position }}
                />
                <div class="nb-story__body">
                  <p class="nb-story__meta">{label} · {article.minutes} мин</p>
                  <h3 id={'nb-title-' + article.slug}>{title}</h3>
                  <p class="nb-story__deck" id={'nb-deck-' + article.slug}>{article.description}</p>
                </div>
              </a>
              <p class="nb-credit">Фото <a href={photo.source}>{photo.photographer}</a> · <a href={photoLicenseUrl}>Pexels</a></p>
            </article>
          );
        })}
      </div>
    </section>

    <section id="tools" class="nb-tools" aria-labelledby="nb-tools-title">
      <div class="nb-width nb-tools__inner" id="calculator">
        <div class="nb-tools__title">
          <h2 id="nb-tools-title">Шаблоны Excel</h2>
          <a class="nb-archive-link" href={path('tools/')}>Все инструменты <span class="nb-arrow" aria-hidden="true">→</span></a>
        </div>
        <ul aria-label="Шаблоны Excel">
          {templates.map(template => (
            <li><a href={path('downloads/' + template.file)} download>{template.label} <span aria-hidden="true">↓</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Site>

<script>
  const form = document.querySelector<HTMLFormElement>('#nb-search');
  const query = document.querySelector<HTMLInputElement>('#nb-query');
  const filters = document.querySelector<HTMLElement>('.nb-filters');
  const cards = [...document.querySelectorAll<HTMLElement>('.nb-story')];
  const opening = document.querySelector<HTMLElement>('.nb-opening');
  const feed = document.querySelector<HTMLElement>('#articles');
  const grid = document.querySelector<HTMLElement>('#nb-grid');
  const status = document.querySelector<HTMLElement>('#nb-status');
  const feedback = document.querySelector<HTMLElement>('#nb-feedback');
  const actions = document.querySelector<HTMLElement>('#nb-feedback-actions');
  const reset = document.querySelector<HTMLButtonElement>('#nb-reset');
  const searchAll = document.querySelector<HTMLAnchorElement>('#nb-search-all');

  if (form && query && filters && opening && feed && grid && status && feedback && actions && reset && searchAll) {
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('button[data-topic]')];
    const topicIds = new Set(buttons.map(button => button.dataset.topic));
    const normalize = (value: string) => value.toLocaleLowerCase('ru').replaceAll('ё', 'е').trim();
    const searchableStories = cards.map(card => ({ card, text: normalize(card.dataset.search ?? '') }));
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let activeTopic = 'all';
    let filterAnimation: Animation | undefined;

    motion.addEventListener?.('change', () => {
      if (motion.matches) filterAnimation?.cancel();
    });

    const updateFeed = (animate = false) => {
      filterAnimation?.cancel();
      const phrase = query.value.trim();
      const words = normalize(phrase).split(/\s+/).filter(Boolean);
      const filtering = Boolean(phrase) || activeTopic !== 'all';
      const searchUrl = new URL(form.action);
      let count = 0;

      for (const { card, text } of searchableStories) {
        const matchesTopic = activeTopic === 'all' || card.dataset.category === activeTopic;
        card.hidden = filtering ? !(matchesTopic && words.every(word => text.includes(word))) : card.dataset.preview !== 'true';
        if (!card.hidden) count++;
      }

      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.topic === activeTopic));
      opening.hidden = filtering;
      grid.toggleAttribute('data-filtered', filtering);
      feedback.toggleAttribute('data-active', filtering);
      actions.hidden = !filtering;
      searchAll.hidden = !phrase;
      if (phrase) searchUrl.searchParams.set('q', phrase);
      searchAll.href = searchUrl.href;
      status.textContent = filtering ? (count ? 'Найдено: ' + count : 'В ленте ничего не нашлось.') : '';
      if (animate && count && !motion.matches && typeof grid.animate === 'function') {
        filterAnimation = grid.animate([{ opacity: .75 }, { opacity: 1 }], { duration: 170, easing: 'ease-out' });
      }
    };

    const restoreFilters = () => {
      const params = new URL(location.href).searchParams;
      const topic = params.get('topic') ?? 'all';
      activeTopic = topicIds.has(topic) ? topic : 'all';
      query.value = (params.get('q') ?? '').slice(0, query.maxLength);
      updateFeed();
    };

    const saveFilters = (push = false) => {
      const url = new URL(location.href);
      const phrase = query.value.trim();
      if (phrase) url.searchParams.set('q', phrase);
      else url.searchParams.delete('q');
      if (activeTopic !== 'all') url.searchParams.set('topic', activeTopic);
      else url.searchParams.delete('topic');
      if (url.href === location.href) return;
      if (push) history.pushState(history.state, '', url);
      else history.replaceState(history.state, '', url);
    };

    filters.hidden = false;
    query.addEventListener('input', () => {
      updateFeed();
      saveFilters();
    });
    form.addEventListener('submit', event => {
      event.preventDefault();
      updateFeed();
      saveFilters();
      feed.scrollIntoView({ block: 'start' });
    });

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const topic = button.dataset.topic ?? 'all';
        if (topic === activeTopic) return;
        activeTopic = topic;
        updateFeed(true);
        saveFilters(true);
      });
    }

    reset.addEventListener('click', () => {
      query.value = '';
      activeTopic = 'all';
      updateFeed();
      saveFilters(true);
      query.focus();
    });

    window.addEventListener('popstate', restoreFilters);
    restoreFilters();
  }
</script>
