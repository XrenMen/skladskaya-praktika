---
import Site from '../../layouts/Site.astro';
import { articlePath, path } from '../../lib/site';
import { practiceTools } from '../../lib/practice-tools';
import { photoForArticle } from '../../lib/media';
import '../../styles/practice-tools.css';

const examples = {
  'tools/warehouse-quotes/': 'За месяц · Склад 1 — 66 800 ₽, Склад 2 — 64 900 ₽, Склад 3 — 64 300 ₽.',
  'tools/warehouse-checklist/': 'Маршрут · Въезд и док → приёмка и хранение → пробная поставка и выдача.',
  'tools/peak-capacity/': 'Доступно 130 мест, в пик нужно 121. Остаток · 86 → 121 → 93 → 109.',
  'calculator/': '80 паллет × 30 дней = 2 400 паллето-дней.',
};
---
<Site title="Инструменты для склада" description="Сравнение складских тарифов, чек-лист осмотра, расчёт запаса паллетомест и стоимости хранения." section="tools" image={photoForArticle('warehouse-site-audit').large}>
  <header class="practice-tool-head practice-index-head">
    <h1>Инструменты для склада</h1>
    <p class="lede">Осмотрите площадку, рассчитайте запас мест и сравните предложения складов на одном объёме работы.</p>
  </header>

  <ul class="practice-index" aria-label="Инструменты">
    {practiceTools.map((tool) => (
      <li class="practice-index__item">
        <h2><a class="practice-index__action" href={path(tool.path)}>{tool.title} <span aria-hidden="true">→</span></a></h2>
        <details class="practice-index__details">
          <summary aria-label={'Пример и инструкция для раздела «' + tool.title + '»'}>Пример и инструкция</summary>
          <p>{tool.description}</p>
          <p class="practice-index__example">{examples[tool.path]}</p>
          <a class="practice-index__article" href={articlePath(tool.article)}>{tool.articleTitle}</a>
        </details>
      </li>
    ))}
  </ul>
</Site>
