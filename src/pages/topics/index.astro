---
import Site from '../../layouts/Site.astro';
import articles from '../../lib/content.mjs';
import { categories, categoryPath } from '../../lib/site';
---
<Site title="Рубрики справочника" description="Выберите направление: хранение, фулфилмент или складские операции." section="topics">
  <header class="inner-head"><p class="eyebrow">Навигация</p><h1>Рубрики</h1><p class="lede">Материалы сгруппированы по рабочим задачам.</p></header>
  <div class="topics">{categories.map(c=><a href={categoryPath(c.id)} class="topic"><small>{c.mark} / {articles.filter(a=>a.category===c.id).length} материала</small><strong>{c.title} <span aria-hidden="true">↗</span></strong><p>{c.description}</p></a>)}</div>
</Site>