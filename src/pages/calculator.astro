---
import Site from '../layouts/Site.astro';
import { articlePath, path } from '../lib/site';
import '../styles/tools.css';
import '../styles/practice-tools.css';
---
<Site title="Калькулятор паллето-дней" description="Рассчитайте объём хранения в паллето-днях и его стоимость по собственному тарифу." section="tools">
  <header class="tool-head">
    <a href={path('tools/')} class="practice-tool-back"><span aria-hidden="true">←</span> Все инструменты</a>
    <h1>Калькулятор паллето-дней</h1>
    <p class="lede">Введите средний остаток и срок хранения. Если знаете тариф, калькулятор оценит стоимость.</p>
  </header>
  <form class="storage-tool" id="storage-calculator">
    <div class="storage-fields">
      <div class="storage-field">
        <label for="storage-pallets">Средний остаток <span>паллеты</span></label>
        <input id="storage-pallets" name="pallets" type="number" inputmode="decimal" min="0" max="1000000" step="0.1" value="80" required aria-describedby="storage-pallets-error" />
        <p class="field-error" id="storage-pallets-error" hidden>Введите число от 0 до 1 000 000 с точностью до 0,1.</p>
      </div>
      <div class="storage-field">
        <label for="storage-days">Срок хранения <span>дни</span></label>
        <input id="storage-days" name="days" type="number" inputmode="numeric" min="1" max="366" step="1" value="30" required aria-describedby="storage-days-error" />
        <p class="field-error" id="storage-days-error" hidden>Введите целое число от 1 до 366.</p>
      </div>
      <div class="storage-field">
        <label for="storage-rate">Тариф <span>₽ за паллето-день</span></label>
        <input id="storage-rate" name="rate" type="number" inputmode="decimal" min="0" max="1000000" step="0.01" placeholder="Необязательно" aria-describedby="storage-rate-error" />
        <p class="field-error" id="storage-rate-error" hidden>Введите сумму от 0 до 1 000 000 ₽ с точностью до копейки.</p>
      </div>
    </div>
    <div class="storage-receipt" aria-live="polite" aria-atomic="true">
      <h2>Объём хранения</h2>
      <p class="storage-total"><strong id="storage-volume">2 400</strong> <span>паллето-дней</span></p>
      <p class="storage-equation" id="storage-equation">80 паллет × 30 дней</p>
      <div class="storage-price">
        <h3>Стоимость хранения</h3>
        <p id="storage-cost">Введите тариф для расчёта</p>
      </div>
    </div>
  </form>
  <p class="storage-scope">Оценка включает только хранение. Приёмка, отгрузка, обработка и налоги рассчитываются отдельно.</p>
  <noscript><p>Для расчёта вручную умножьте средний остаток на число дней. Стоимость получится, если умножить объём на тариф.</p></noscript>
  <section class="storage-help" aria-labelledby="storage-help-title">
    <h2 id="storage-help-title">Если остатки меняются</h2>
    <div>
      <p>Разбейте срок на интервалы с близкими остатками, посчитайте объём для каждого и сложите результаты.</p>
      <p><a href={articlePath('storage-cost')}>Что входит в складскую смету</a></p>
      <p><a href={path('tools/warehouse-quotes/')}>Сравнить полную стоимость по трём тарифам <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
  <script is:inline type="module" src={path('assets/calculator.js')}></script>
</Site>