---
import Site from '../../layouts/Site.astro';
import articles from '../../lib/content.mjs';
import { articleRoutes } from '../../lib/editorial-paths';
import { articlePath, categories, categoryPath, path, siteName, type Article } from '../../lib/site';
import { photoForArticle } from '../../lib/media';
import '../../styles/reading.css';

export function getStaticPaths() {
  return articles.map(article => ({ params: { slug: article.slug }, props: { article } }));
}

const { article }: { article: Article } = Astro.props;
const category = categories.find(item => item.id === article.category)!;
const route = articleRoutes[article.slug];
const related = route?.guides.flatMap(guide => {
  const match = articles.find(item => item.slug === guide.slug);
  return match ? [{ ...guide, title: match.title }] : [];
}) ?? [];
const tool = route?.tool;
const image = photoForArticle(article.slug);
const dateFormatter = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const dateLabel = (date: string) => dateFormatter.format(new Date(date + 'T00:00:00Z'));

const sections: Array<{ id: string; label: string }> = [];
let tableNumber = 0;
const body = article.body
  .replace(/href="#storage-calculator"/g, 'href="' + path('calculator/') + '#storage-calculator"')
  .replace(/href="\.\.\/([a-z0-9-]+)\/"/g, (_match, slug: string) => 'href="' + articlePath(slug) + '"')
  .replace(/href="\.\.\/\.\.\/tools\/([a-z0-9-]+)\/"/g, (_match, slug: string) => 'href="' + path('tools/' + slug + '/') + '"')
  .replace(/href="\.\.\/\.\.\/downloads\/([a-z0-9-]+\.xlsx)"/g, (_match, file: string) => 'href="' + path('downloads/' + file) + '"')
  .replace(/<h2>(.*?)<\/h2>|<table\b[^>]*>.*?<\/table>/gs, (markup, heading) => {
    if (heading !== undefined) {
      const id = 'razdel-' + (sections.length + 1);
      const label = heading.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&');
      sections.push({ id, label });
      return '<h2 id="' + id + '" tabindex="-1">' + heading + '</h2>';
    }

    const id = 'reading-table-' + ++tableNumber;
    const columns = markup.match(/<thead\b[^>]*>.*?<\/thead>/s)?.[0].match(/<th(?=[\s>])/g)?.length;
    const numeric = /^<table\s+data-numeric[\s>]/.test(markup);
    const compact = numeric || columns === 2 ? ' data-compact' : '';
    const hasCaption = /<caption\b[^>]*>/.test(markup);
    const title = hasCaption ? id + '-caption' : sections.at(-1)?.id;
    const name = title ? 'aria-labelledby="' + title + '"' : 'aria-label="Таблица ' + tableNumber + '"';
    const table = hasCaption ? markup.replace(/<caption\b/, '<caption id="' + title + '"') : markup;
    const hint = '<p class="table-scroll-hint" id="' + id + '-hint" hidden data-pagefind-ignore>Таблицу можно прокручивать по горизонтали.</p>';
    return hint + '<div class="table-scroll" role="region" ' + name + compact + ' tabindex="0">' + table + '</div>';
  });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  inLanguage: 'ru',
  datePublished: article.published,
  dateModified: article.updated ?? article.published,
  image: new URL(image.large, Astro.site).href,
  author: {
    '@type': 'Organization',
    name: 'Редакция «Складская практика»',
    url: new URL(path('editorial/'), Astro.site).href,
  },
  publisher: { '@type': 'Organization', name: siteName, url: new URL(path(), Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Site title={article.title} description={article.description} section="materials" type="article" image={image.large} jsonLd={jsonLd}>
  <article class="journal-article" data-pagefind-body>
    <div class="article-column">
      <header class="article-mast">
        <nav class="article-trail" aria-label="Путь к статье" data-pagefind-ignore>
          <a href={path('materials/')}>Статьи</a>
          <span aria-hidden="true">/</span>
          <a href={categoryPath(category.id)}>{category.name}</a>
          <span aria-hidden="true">·</span>
          <span>{article.minutes} мин чтения</span>
        </nav>
        <a class="article-return" id="article-return" data-pagefind-ignore hidden></a>
        <h1 data-pagefind-meta="title">{article.title}</h1>
        <p class="lede">{article.description}</p>
        <p class="article-byline" data-pagefind-ignore>
          <a href={path('editorial/')}>Редакция «Складская практика»</a>
          <time datetime={article.published}>{dateLabel(article.published)}</time>
          {article.updated && article.updated !== article.published && (
            <span>Обновлено <time datetime={article.updated}>{dateLabel(article.updated)}</time></span>
          )}
        </p>
      </header>

      {sections.length > 0 && (
        <details class="article-guide" data-pagefind-ignore>
          <summary id="article-sections">Оглавление</summary>
          <nav aria-label="Разделы статьи">
            <ol>
              {sections.map(section => <li><a href={'#' + section.id}>{section.label}</a></li>)}
            </ol>
          </nav>
        </details>
      )}

      <figure class="article-media">
        <img
          src={image.large}
          srcset={image.srcset}
          sizes="(max-width: 720px) 94vw, (max-width: 1040px) 68vw, 661px"
          width={image.largeWidth}
          height={image.largeHeight}
          fetchpriority="high"
          style={{ objectPosition: image.position }}
          alt={image.alt}
        />
      </figure>

      <div class="article-copy">
        <div class="reading" set:html={body} />
        {sections.length > 0 && (
          <p class="article-up" data-pagefind-ignore>
            <a href="#article-sections">К оглавлению <span aria-hidden="true">↑</span></a>
          </p>
        )}
      </div>
    </div>

    {(related.length > 0 || tool) && (
      <aside class="article-next" aria-labelledby="related" data-pagefind-ignore>
        <h2 id="related">По теме</h2>
        <ul class="article-followups">
          {related.map(item => (
            <li>
              <a href={articlePath(item.slug)}>
                <strong>{item.title}</strong>
                <span class="article-followup-detail">{item.reason}</span>
              </a>
            </li>
          ))}
          {tool && (
            <li>
              <a href={path(tool.route)}>
                <span class="article-followup-label">Инструмент</span>
                <strong>{tool.label}</strong>
                <span class="article-followup-detail">{tool.reason}</span>
              </a>
            </li>
          )}
        </ul>
        <a class="article-category" href={categoryPath(category.id)}>Все статьи рубрики <span aria-hidden="true">↗</span></a>
      </aside>
    )}
  </article>
</Site>

<script>
  import { categories, path } from '../../lib/site';

  for (const region of document.querySelectorAll<HTMLElement>('.table-scroll')) {
    const hint = region.previousElementSibling;
    const table = region.querySelector('table');
    if (!(hint instanceof HTMLElement) || !table) continue;

    const updateScrollState = () => {
      const scrolls = region.scrollWidth > region.clientWidth;
      hint.hidden = !scrolls;
      if (scrolls) {
        region.tabIndex = 0;
        region.setAttribute('aria-describedby', hint.id);
      } else {
        region.removeAttribute('tabindex');
        region.removeAttribute('aria-describedby');
      }
    };

    updateScrollState();
    if (typeof ResizeObserver !== 'undefined') {
      const observer = new ResizeObserver(updateScrollState);
      observer.observe(region);
      observer.observe(table);
    }
  }

  const link = document.querySelector<HTMLAnchorElement>('#article-return');
  if (link && document.referrer) {
    const source = new URL(document.referrer);
    const searchPath = path('search/');
    const homePath = path();
    const query = source.searchParams.get('q')?.slice(0, 120).trim() ?? '';
    const topic = categories.find(({ id }) => source.searchParams.get('topic') === id)?.id;
    const fromSearch = source.pathname === searchPath && query.length >= 2;
    const fromFeed = source.pathname === homePath && Boolean(query || topic);

    if (source.origin === location.origin && (fromSearch || fromFeed)) {
      const target = new URL(source.pathname, location.origin);
      if (query) target.searchParams.set('q', query);
      if (fromFeed) {
        if (topic) target.searchParams.set('topic', topic);
        target.hash = 'articles';
      }
      link.href = target.href;
      link.textContent = fromSearch ? 'К результатам поиска' : 'К отфильтрованной ленте';
      link.hidden = false;
    }
  }
</script>
