---
import Site from '../../layouts/Site.astro';
import Card from '../../components/Card.astro';
import articles from '../../lib/content.mjs';
import { path, categories, categoryPath } from '../../lib/site';
import { photo } from '../../lib/media';
const image=photo('cover');
---
<Site title="Все статьи журнала" description="Руководства по выбору склада, расчёту хранения, запуску фулфилмента и приёмке товара." section="materials" image={image.large}>
  <header class="inner-head blog-head"><h1>Статьи</h1><p class="lede">Чек-листы и расчёты для складских задач. Выберите рубрику или <a href={path('search/')}>найдите статью по слову</a>.</p>
  <nav class="rubric-nav" aria-label="Рубрики журнала"><a aria-current="page" href={path('materials/')}>Все статьи · {articles.length}</a>{categories.map(c=><a href={categoryPath(c.id)}>{c.name}</a>)}</nav></header>
  <div class="cards">{articles.map(item=><Card item={item}/>)}</div>
</Site>