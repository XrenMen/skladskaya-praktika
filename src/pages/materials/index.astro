---
import Site from '../../layouts/Site.astro';
import Card from '../../components/Card.astro';
import articles from '../../lib/content.mjs';
import { path } from '../../lib/site';
---
<Site title="Все материалы" description="Пошаговые руководства по выбору склада, расчёту хранения, запуску фулфилмента и приёмке товара." section="materials">
  <header class="inner-head"><p class="eyebrow">Библиотека</p><h1>Материалы</h1><p class="lede">Разберите свою задачу по шагам. <a href={path('search/')}>Найти статью по ключевому слову</a>.</p></header>
  <div class="cards">{articles.map(item=><Card item={item}/>)}</div>
</Site>