---
import Site from '../../layouts/Site.astro';
import Card from '../../components/Card.astro';
import CollectionNav from '../../components/CollectionNav.astro';
import articles from '../../lib/content.mjs';
import { path } from '../../lib/site';
import { photoForArticle } from '../../lib/media';
---
<Site title="Все статьи журнала" description="Руководства по выбору склада, расчёту хранения, запуску фулфилмента и приёмке товара." section="materials" image={photoForArticle('receiving-discrepancies').large}>
  <header class="collection-head collection-head--archive">
    <h1>Статьи</h1>
    <form class="collection-search-form" action={path('search/')} role="search" aria-label="Поиск по статьям">
      <label class="collection-visually-hidden" for="archive-query">Поиск по статьям</label>
      <input id="archive-query" name="q" type="search" maxlength="120" autocomplete="off" placeholder="Поиск по статьям" />
      <button type="submit">Найти</button>
    </form>
  </header>
  <CollectionNav />
  <ul class="collection-list">
    {articles.map((item, index) => <li><Card item={item} heading="h2" eager={index < 4} /></li>)}
  </ul>
</Site>
