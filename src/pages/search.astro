---
import Site from '../layouts/Site.astro';
import {path} from '../lib/site';
---
<Site title="Поиск по статьям" description="Найдите нужную памятку по слову или теме: хранение, поставка, возвраты и другие складские операции." section="search">
  <header class="inner-head"><p class="eyebrow">Справочник</p><h1>Поиск по статьям</h1><p class="lede">Например: «паллето-дни», «возвраты» или «переезд».</p></header>
  <form id="article-search" class="search-form" action={path('search/')} role="search"><label class="search-label" for="query">Запрос<input class="search-box" type="search" id="query" name="q" autocomplete="off" maxlength="120" placeholder="Что хотите найти?"></label><button class="button" type="submit">Найти</button></form>
  <div class="search-hints">{['Хранение','Возвраты','Переезд','Отгрузка'].map(q=><a class="chip" href={path('search/?q='+encodeURIComponent(q))}>{q}</a>)}</div>
  <p class="search-status muted" id="search-status" role="status"></p>
  <ul class="search-results" id="search-results"></ul>
  <noscript><p>Поиск требует JavaScript. Откройте <a href={path('materials/')}>перечень всех материалов</a>.</p></noscript>
  <script is:inline type="module" src={path('assets/search.js')}></script>
</Site>