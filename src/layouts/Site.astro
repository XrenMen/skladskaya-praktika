---
import { path, siteName } from '../lib/site';
import '../styles/site.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/journal.css';
import '../styles/factory-shell.css';
interface Props { title: string; description: string; section?: string; type?: 'website'|'article'; image?: string; jsonLd?: Record<string,unknown>; notFound?: boolean }
const {title,description,section,type='website',image=path('photos/cover-1280.webp'),jsonLd,notFound=false}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title + ' — ' + siteName;
const nav = [
  { id:'topics', title:'Рубрики', href:path('topics/') },
  { id:'materials', title:'Статьи', href:path('materials/') },
  { id:'tools', title:'Инструменты', href:path('tools/') },
  { id:'search', title:'Поиск', href:path('search/') }
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>
  {!notFound && <link rel="canonical" href={canonical} />}
  <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={siteName} href={path('rss.xml')} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:image" content={new URL(image,Astro.site)} />
  {!notFound && <meta property="og:url" content={canonical} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g,'\\u003c')} />}
</head>
<body>
<a href="#main" class="skip">К содержанию</a>
<header class="site-top">
  <div class="mast wrap">
    <a href={path()} class="brand" aria-label="Складская практика — главная">
      <img src={path('favicon.svg')} width="38" height="38" alt="" />
      <span>Складская практика</span>
    </a>
    <nav aria-label="Главное меню">
      {nav.map(item => (
        <a href={item.href} aria-current={section === item.id ? 'page' : undefined}>
          {item.id === 'search' && <span class="shell-search-mark" aria-hidden="true"></span>}
          {item.title}
        </a>
      ))}
    </nav>
  </div>
</header>
<main class:list={[section === 'home' ? 'home-main' : 'wrap']} id="main" tabindex="-1"><slot /></main>
<footer class="foot site-foot">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-name">Складская практика</p>
      <p>Информационный журнал для команд складской логистики</p>
    </div>
    <nav aria-label="О журнале">
      <a href={path('about/')}>О проекте</a>
      <a href={path('editorial/')}>Редакция</a>
      <a href={path('rss.xml')}>RSS</a>
    </nav>
  </div>
</footer>
</body>
</html>