---
import { path, siteName } from '../lib/site';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/journal.css';
import '../styles/factory-shell.css';
interface Props { title: string; description: string; section?: string; type?: 'website'|'article'; image?: string; jsonLd?: Record<string,unknown>; notFound?: boolean }
const {title,description,section,type='website',image=path('photos/cover-1280.webp'),jsonLd,notFound=false}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title + ' — ' + siteName;
const nav = [
  { id:'materials', title:'Статьи', href:path('materials/') },
  { id:'topics', title:'Рубрики', href:path('topics/') },
  { id:'tools', title:'Инструменты', href:path('tools/') },
  { id:'search', title:'Поиск', href:path('search/') }
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>
  {!notFound && <link rel="canonical" href={canonical} />}
  <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={siteName} href={path('rss.xml')} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:image" content={new URL(image,Astro.site)} />
  {!notFound && <meta property="og:url" content={canonical} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g,'\\u003c')} />}
</head>
<body>
<a href="#main" class="skip">К содержанию</a>
<header class="site-top" id="site-top" tabindex="-1">
  <div class="mast journal-shell">
    <a href={path()} class="brand" aria-label={siteName + ' — главная'} aria-current={section === 'home' ? 'page' : undefined}>
      {siteName}
    </a>
    <nav class="site-nav" aria-label="Главное меню">
      {nav.map(item => (
        <a
          class:list={[{ 'site-nav-search': item.id === 'search' }]}
          href={item.href}
          aria-current={section === item.id ? (Astro.url.pathname === item.href ? 'page' : 'location') : undefined}
        >
          {item.id === 'search' && <span class="site-search-icon" aria-hidden="true"></span>}
          {item.title}
        </a>
      ))}
    </nav>
  </div>
</header>
<main class:list={[section === 'home' ? 'home-main' : 'wrap']} id="main" tabindex="-1"><slot /></main>
<SiteFooter />
</body>
</html>