---
import { path } from '../lib/site';
import { practiceTools } from '../lib/practice-tools';
import '../styles/practice-tools.css';

const [checklist, ...calculators] = practiceTools;
---
<section class="wrap practice-teaser" id="calculator" aria-labelledby="practice-teaser-title">
  <header class="practice-teaser__header">
    <h2 id="practice-teaser-title">Рабочие инструменты</h2>
    <a href={path('tools/')}>Все инструменты <span aria-hidden="true">→</span></a>
  </header>

  <div class="practice-teaser__content">
    <a class="practice-teaser__lead" href={path(checklist.path)}>
      <h3>{checklist.title}</h3>
      <p>{checklist.description}</p>
      <span class="practice-teaser__action">{checklist.action} <span aria-hidden="true">→</span></span>
    </a>
    <ul class="practice-teaser__list">
      {calculators.map(tool => (
        <li>
          <a href={path(tool.path)}>
            <div><h3>{tool.title}</h3><p>{tool.description}</p></div>
            <span class="practice-teaser__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
