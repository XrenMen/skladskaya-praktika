---
import {categoryPath,categories} from '../lib/site';
import {photoForCategory} from '../lib/media';
import articles from '../lib/content.mjs';
---
<div class="topic-grid">{categories.map(c=>{
 const image=photoForCategory(c.id);
 const count=articles.filter(a=>a.category===c.id).length;
 return <a class="topic journal-item" href={categoryPath(c.id)}>
   <div class="journal-thumb"><img src={image.small} srcset={image.srcset} width="640" height="426" sizes="(max-width: 540px) 28vw, 240px" loading="lazy" decoding="async" alt="" /></div>
   <div class="journal-item-text"><p class="kicker"><span>Рубрика {c.mark}</span><span>{count} материала</span></p><h3>{c.title}</h3><p class="muted">{c.description}</p></div><span class="item-arrow" aria-hidden="true">↗</span>
 </a>;
})}</div>