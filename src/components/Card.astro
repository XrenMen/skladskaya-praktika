---
import { articlePath, categories, type Article } from '../lib/site';
import { photoForArticle, photoLicenseUrl } from '../lib/media';
import '../styles/factory-collections.css';

interface Props {
  item: Article;
  hideTopic?: boolean;
  eager?: boolean;
  heading?: 'h2' | 'h3';
}

const { item, hideTopic = false, eager = false, heading: Heading = 'h3' } = Astro.props;
const topic = categories.find(category => category.id === item.category);
const image = photoForArticle(item.slug);
---
<article class="collection-card">
  <a class="collection-card-link" href={articlePath(item.slug)}>
    <div class="collection-card-photo">
      <img
        src={image.small}
        srcset={image.srcset}
        sizes="(max-width: 520px) 94vw, (max-width: 920px) 46vw, (max-width: 1560px) 23vw, 355px"
        width={image.smallWidth}
        height={image.smallHeight}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        style={{ objectPosition: image.position }}
        alt={image.alt}
      />
    </div>
    <p class="collection-meta">{!hideTopic && topic && <span>{topic.name}</span>}<span>{item.minutes} мин</span></p>
    <Heading class="collection-card-title">{item.title}</Heading>
    <p class="collection-card-summary">{item.description}</p>
  </a>
  <p class="collection-credit">Фото <a href={image.source}>{image.photographer}</a> · <a href={photoLicenseUrl} aria-label="Лицензия фотографий Pexels">Pexels</a></p>
</article>
