---
import {articlePath,categories,type Article} from '../lib/site';
import {photoForArticle} from '../lib/media';
const {item}=Astro.props as {item:Article};
const topic=categories.find(c=>c.id===item.category);
const image=photoForArticle(item.slug);
---
<a class="card journal-item" href={articlePath(item.slug)}>
  <div class="journal-thumb"><img loading="lazy" decoding="async" width="640" height="426" src={image.small} srcset={image.srcset} sizes="(max-width: 540px) 28vw, 240px" style={{objectPosition:image.position}} alt="" /></div>
  <div class="journal-item-text"><p class="kicker"><span>{topic?.name}</span><span>{item.minutes} мин</span></p><h3>{item.title}</h3><p class="muted">{item.description}</p></div><span class="item-arrow" aria-hidden="true">↗</span>
</a>