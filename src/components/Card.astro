---
import { articlePath, categories, type Article } from '../lib/site';
import { photoForArticle } from '../lib/media';
import { articleTeaserTitle } from '../lib/teaser-titles';
import '../styles/factory-collections.css';

interface Props {
  item: Article;
  hideTopic?: boolean;
  eager?: boolean;
  heading?: 'h2' | 'h3';
}

const { item, hideTopic = false, eager = false, heading: Heading = 'h3' } = Astro.props;
const topic = categories.find(category => category.id === item.category);
const image = photoForArticle(item.slug);
const titleId = 'collection-title-' + item.slug;
const cardSizes = '(max-width: 570px) 94vw, (max-width: 860px) 46vw, (max-width: 1160px) 30vw, 300px';
---
<article class="collection-card">
  <a class="collection-card-link" href={articlePath(item.slug)} aria-labelledby={titleId}>
    <div class="collection-card-photo">
      <img
        src={image.small}
        srcset={image.srcset}
        sizes={eager ? cardSizes : 'auto, ' + cardSizes}
        width={image.smallWidth}
        height={image.smallHeight}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        style={{ objectPosition: image.position }}
        alt={image.alt}
      />
    </div>
    <p class="collection-meta">{!hideTopic && topic && <span>{topic.name}</span>}<span>{item.minutes} мин</span></p>
    <Heading id={titleId} class="collection-card-title">{articleTeaserTitle(item)}</Heading>
    <p class="collection-card-summary">{item.description}</p>
  </a>
</article>
