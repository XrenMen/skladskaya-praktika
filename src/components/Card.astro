---
import { articlePath, categories, type Article } from '../lib/site';
import { photoForArticle } from '../lib/media';
import '../styles/factory-collections.css';

interface Props {
  item: Article;
  emphasis?: 'lead' | 'side';
  compact?: boolean;
  hideTopic?: boolean;
  heading?: 'h2' | 'h3';
}

const { item, emphasis, compact = false, hideTopic = false, heading: Heading = 'h3' } = Astro.props;
const topic = categories.find(category => category.id === item.category);
const image = photoForArticle(item.slug);
const sizes = compact
  ? '(max-width: 680px) 100px, 200px'
  : emphasis === 'lead'
    ? '(max-width: 680px) 92vw, (max-width: 1300px) 54vw, 740px'
    : '(max-width: 680px) 92vw, (max-width: 1300px) 46vw, 620px';
---
<a class:list={['collection-card', { 'collection-card--lead': emphasis === 'lead', 'collection-card--side': emphasis === 'side', 'collection-card--compact': compact }]} href={articlePath(item.slug)}>
  <div class="collection-card-photo">
    <img
      src={image.small}
      srcset={image.srcset}
      sizes={sizes}
      width={image.smallWidth}
      height={image.smallHeight}
      loading={emphasis === 'lead' ? 'eager' : 'lazy'}
      fetchpriority={emphasis === 'lead' ? 'high' : undefined}
      decoding="async"
      style={{ objectPosition: image.position }}
      alt=""
    />
  </div>
  <div class="collection-card-copy">
    <p class="collection-meta">{!hideTopic && topic && <span>{topic.name}</span>}<span>{item.minutes} мин<span class="collection-reading-label"> чтения</span></span></p>
    <Heading class="collection-card-title">{item.title}</Heading>
    <p class="collection-card-summary">{item.description}</p>
    <span class="collection-arrow" aria-hidden="true">↗</span>
  </div>
</a>